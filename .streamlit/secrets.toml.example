# 复制成 .streamlit/secrets.toml（本地）或粘贴到 Streamlit Cloud 的 Secrets 设置里。
# 不填 Key 也能运行：报告照常用资料库生成，只是没有「问问 AI」。

DEEPSEEK_API_KEY = "sk-..."

# 可选：换成其他 OpenAI 兼容接口（比如智谱、Kimi）时再改
# LLM_BASE_URL = "https://api.deepseek.com"
# LLM_MODEL = "deepseek-flash"   # 也可以用 deepseek-v4-pro（更强、更贵）

# 可选：分享图底部显示的网址
# SITE_URL = "你的网址.streamlit.app"

# 可选：「问问 AI」每位访客每次最多提几个问题（默认 3，填 0 就关掉提问）
# ASK_LIMIT = 3

# 可选：报告要不要让 AI 写（默认不用，直接用资料库文字；填 true 就让 AI 写，读起来更顺，但每个新组合要调用一次 AI）
# REPORT_AI = true
